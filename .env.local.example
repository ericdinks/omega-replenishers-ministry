# ---------------------------------------------------------------------------
# Supabase (Backend & Storage)
# Find these in your Supabase project: Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-side ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively by /admin server actions and route handlers to read all
# prayer requests (which are protected from anonymous SELECT by RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# YouTube (Live Broadcast + School of the Prophets)
# ---------------------------------------------------------------------------
# Channel ID (starts with "UC...") used to detect real-time LIVE status
# and to fetch the channel's most recent upload as the Live Broadcast
# page's fallback video whenever nothing is currently live.
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=your-channel-id
# YouTube Data API v3 key, used server-side to poll live status.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-data-api-key
# Playlist ID that powers the "School of the Prophets" hub. Admins can
# rotate this without a deploy by updating the env var in Vercel.
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=your-playlist-id

# ---------------------------------------------------------------------------
# PayPal (Tithing & Giving Hub)
# ---------------------------------------------------------------------------
# The ministry's public PayPal.Me link OR hosted "Donate" button link.
# Example PayPal.Me:  https://paypal.me/ProphetShedrackAO
# Example Donate link: https://www.paypal.com/donate/?hosted_button_id=XXXXXXXXXXXXX
NEXT_PUBLIC_PAYPAL_LINK=https://paypal.me/ProphetShedrackAO
# Three-letter ISO currency code appended to PayPal.Me links.
NEXT_PUBLIC_PAYPAL_CURRENCY=USD

# ---------------------------------------------------------------------------
# PayPal Checkout (/store -- automatic e-book & music delivery)
# ---------------------------------------------------------------------------
# From https://developer.paypal.com -> Apps & Credentials. Create a
# Sandbox app first and test the full purchase flow with fake money
# before switching PAYPAL_MODE to "live" with a Live app's credentials.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# "sandbox" (fake money, safe to test) or "live" (real payments).
PAYPAL_MODE=sandbox

# ---------------------------------------------------------------------------
# Resend (Order Notification + Delivery Emails)
# ---------------------------------------------------------------------------
# https://resend.com/api-keys -- emails the customer their download link
# automatically the moment a /store payment is captured, and notifies the
# ministry's order-notification address (Homepage & About Text tab in
# /admin). NOTE: without a verified domain, Resend's shared sender can
# only deliver to the email the Resend account itself was created with --
# real customers won't receive the email until a domain is verified, but
# they still see the download link immediately on-screen either way.
RESEND_API_KEY=your-resend-api-key

# ---------------------------------------------------------------------------
# Official Social Profiles (Footer)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@prophetshedrackao
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@prophetshedrackao
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/prophetshedrackao
